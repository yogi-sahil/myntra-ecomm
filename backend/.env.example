NODE_ENV=development
PORT=8999

DB_HOST=127.0.0.1
DB_USER=myntra_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=myntra_clone

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters

# Obtain fresh credentials from the Razorpay dashboard.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Comma-separated browser origins only when the frontend is hosted separately.
CORS_ORIGINS=
TRUST_PROXY=false

# Used only by `node seed-admin.js`.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-one-time-password
ADMIN_SEED_NAME=Store Admin
ADMIN_SEED_MOBILE=9999999999
